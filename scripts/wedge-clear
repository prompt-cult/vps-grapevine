#!/usr/bin/env bash
# wedge-clear — stop the vibed ACP daemon so a human can take the box over.
#
# Workaround until the daemon coordinates properly with interactive
# sessions. Run ON the host (root or sudo). See server/SETUP-NOTES.md.
#
# Usage:
#   wedge-clear stop     # stop + disable the daemon (default)
#   wedge-clear start    # re-enable + start it again
#   wedge-clear status   # is it running?

set -euo pipefail

UNIT=vibed.service

usage() { echo "usage: wedge-clear [stop|start|status]" >&2; exit 64; }

case "${1:-stop}" in
  stop)
    systemctl stop "$UNIT"
    systemctl disable "$UNIT"
    echo "wedge-clear: $UNIT stopped and disabled"
    ;;
  start)
    systemctl enable "$UNIT"
    systemctl start "$UNIT"
    systemctl --no-pager status "$UNIT" || true
    ;;
  status)
    systemctl --no-pager status "$UNIT" || true
    ;;
  *)
    usage
    ;;
esac
