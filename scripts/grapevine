#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""grapevine — client CLI for talking to a vibe agent on a VPS over SSH.

Environment: SRV_HOST (e.g. root@srv012345.example.hstgr.cloud).
All heavy lifting runs server-side via the mailbox script
/opt/vps-grapevine/vibe-bridge; this client only moves bytes over ssh.

Usage:
  grapevine bootstrap                                     install server side
  grapevine send_message "text" [--attach FILE ...]       async post -> uuid+ts
  grapevine check_messages [--after TS]                   poll inbox+outbox
  grapevine scp-down REMOTE_PATH [LOCAL_DIR]              fetch a reply
  grapevine status | stop                                 daemon control
"""
from __future__ import annotations

import argparse
import json
import os
import pathlib
import subprocess
import sys
from datetime import datetime

SERVER_SCRIPT = "/opt/vps-grapevine/vibe-bridge"
DROP_DIR = "/opt/vps-grapevine/drop-in"
VERSION_FILE = "/opt/vps-grapevine/VERSION"


def sh(*args: str, timeout: int = 120) -> subprocess.CompletedProcess:
    return subprocess.run(list(args), capture_output=True, text=True, timeout=timeout)


def client_version() -> str:
    here = pathlib.Path(__file__).resolve().parent.parent
    try:
        ver = subprocess.run(
            ["git", "-C", str(here), "describe", "--tags", "--match", "20*", "--always"],
            capture_output=True, text=True, timeout=5,
        ).stdout.strip()
    except Exception:
        ver = ""
    return ver or "unknown"


def srv() -> str:
    host = os.environ.get("SRV_HOST")
    if not host:
        raise SystemExit("set SRV_HOST, e.g. SRV_HOST=root@srv012345.example.hstgr.cloud")
    return host


def ssh(script: str, timeout: int = 60) -> str:
    result = subprocess.run(
        ["ssh", "-o", "BatchMode=yes", "-o", "StrictHostKeyChecking=accept-new", srv(), "bash -s"],
        input=script, capture_output=True, text=True, timeout=timeout,
    )
    if result.returncode != 0 and result.stderr.strip():
        raise SystemExit(f"ssh error: {result.stderr.strip()[-400:]}")
    return result.stdout


def bootstrap() -> int:
    here = pathlib.Path(__file__).resolve().parent.parent
    server = here / "server"
    print("bootstrap: pushing server kit (idempotent; never reboots the box)")
    subprocess.run(
        ["ssh", "-o", "BatchMode=yes", "-o", "StrictHostKeyChecking=accept-new", srv(),
         "mkdir -p /opt/vps-grapevine /opt/vps-grapevine/drop-in /root/.ssh"],
        check=True, timeout=60,
    )
    for name in ("vibe-bridge", "BRIDGE-PROTOCOL.md", "AGENTS.md.template"):
        subprocess.run(
            ["scp", "-o", "BatchMode=yes", str(server / name),
             f"{srv()}:/opt/vps-grapevine/{name}"],
            check=True, timeout=120,
        )
    # server version file: what the box is running (version protocol)
    with pathlib.Path("/tmp/xxx/vps-grapevine-VERSION").open("w") as fh:
        fh.write(client_version() + "\n")
    subprocess.run(
        ["scp", "-o", "BatchMode=yes", "/tmp/xxx/vps-grapevine-VERSION",
         f"{srv()}:/opt/vps-grapevine/VERSION"],
        check=True, timeout=60,
    )
    script = r'''
set -e
chmod +x /opt/vps-grapevine/vibe-bridge
# AGENTS.md: append template only if the policy header is not already there
grep -q '# Box policy for the box-manager' /root/AGENTS.md 2>/dev/null || \
  cat /opt/vps-grapevine/AGENTS.md.template >> /root/AGENTS.md
# vibe CLI if missing
if [ ! -x /root/.local/bin/vibe ]; then
  bash -lc 'npm i -g mistral-vibe' >/dev/null 2>&1 || true
fi
install -m 644 /dev/null /var/log/vps-grapevine.log 2>/dev/null || touch /var/log/vps-grapevine.log
# agent profile from the template (Fix: daemon dispatch needs a profile)
install -m 644 /opt/vps-grapevine/AGENTS.md.template /dev/null 2>/dev/null || true
cat > /root/.vibe/agents/box-manager.toml <<'TOMLEOF'
description = "Box agent managed by the vps-grapevine daemon"
TOMLEOF
systemctl daemon-reload
systemctl enable vibed >/dev/null 2>&1 || true
cat > /etc/systemd/system/vibed.service <<'UNIT'
[Unit]
Description=vps-grapevine: box-manager vibe agent daemon (headless)
Documentation=file:///opt/vps-grapevine/vibe-bridge
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
ExecStart=/opt/vps-grapevine/vibe-bridge serve
ExecStop=/opt/vps-grapevine/vibe-bridge stop
Restart=on-failure
RestartSec=5
Environment=PATH=/snap/bin:/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
systemctl enable vibed >/dev/null 2>&1 || true
# first run: create the initial session (daemon resume fails on zero sessions)
if ! ls /root/.vibe/logs/session/.session_index.json >/dev/null 2>&1; then
  /root/.local/bin/vibe -p READY --yolo --agent box-manager --trust >/dev/null 2>&1 || true
fi
systemctl restart vibed
sleep 2
systemctl is-active vibed
echo "bootstrap done: /opt/vps-grapevine (run vibe --setup once for the agent key)"
'''
    print(ssh(script, timeout=300).strip())
    return 0


def send_message(text: str, attachments: list[str]) -> int:
    # 1) allocate uuid server-side
    out = ssh('/opt/vps-grapevine/vibe-bridge new-id', timeout=60).strip()
    mid = json.loads(out)["uuid"]
    files_dir = f"/opt/vps-grapevine/mail/inbox/{mid}/files"
    # 2) push attachments (paths appear in the message verbatim)
    for f in attachments:
        subprocess.run(
            ["scp", "-o", "BatchMode=yes", f, f"{srv()}:{files_dir}/"],
            check=True, timeout=600,
        )
    # 3) post the message (stamped with the client's version — version protocol)
    script = (
        f'/opt/vps-grapevine/vibe-bridge post-message {mid} client '
        f'--version {client_version()} '
        f'"$(cat <<\'MSGEOF\'\n{text}\nMSGEOF\n)"'
    )
    result = ssh(script, timeout=60).strip()
    print(result)
    return 0


def check_messages(after: str) -> int:
    after_arg = f"--after '{after}'" if after else ""
    print(ssh(f"/opt/vps-grapevine/vibe-bridge check-messages {after_arg}", timeout=60).strip())
    return 0


def scp_down(remote: str, local: str) -> int:
    subprocess.run(
        ["scp", "-o", "BatchMode=yes", f"{srv()}:{remote}", local],
        check=True, timeout=600,
    )
    print(f"downloaded {remote}")
    return 0


def status() -> int:
    print(ssh('/opt/vps-grapevine/vibe-bridge status', timeout=60).strip())
    return 0


def stop() -> int:
    print(ssh('/opt/vps-grapevine/vibe-bridge stop', timeout=60).strip())
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="cmd", required=True)
    sub.add_parser("bootstrap")
    send_p = sub.add_parser("send_message")
    send_p.add_argument("text")
    send_p.add_argument("--attach", action="append", default=[])
    check_p = sub.add_parser("check_messages")
    check_p.add_argument("--after", default="")
    down_p = sub.add_parser("scp-down")
    down_p.add_argument("remote")
    down_p.add_argument("local", nargs="?", default=".")
    sub.add_parser("status")
    sub.add_parser("stop")
    args = parser.parse_args()

    if args.cmd == "bootstrap":
        return bootstrap()
    if args.cmd == "send_message":
        return send_message(args.text, args.attach)
    if args.cmd == "check_messages":
        return check_messages(args.after)
    if args.cmd == "scp-down":
        return scp_down(args.remote, args.local)
    if args.cmd == "status":
        return status()
    if args.cmd == "stop":
        return stop()
    return 1


if __name__ == "__main__":
    sys.exit(main())
