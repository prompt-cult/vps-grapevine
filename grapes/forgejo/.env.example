# Forgejo + oauth2-proxy stack env -> /opt/forgejo/.env (mode 600, never committed)
# Fill in from Zitadel Phase 3 output (OIDC app client id/secret); the cookie
# secret is generated on the box:
#   COOKIE_SECRET=$(docker run --rm python:3-alpine python3 -c "import secrets; print(secrets.token_urlsafe(32))")
# Replace SSO.DOMAIN with the Zitadel public domain, APP.DOMAIN with the
# Forgejo public domain, and the version tags with the verified values
# (FORGEJO_VERSION e.g. 16.0.4, OAUTH2_PROXY_VERSION e.g. v7.8.1).
# FORGEJO_DB_PASSWORD is one strong value used by both forgejo-db and forgejo.

OIDC_CLIENT_ID=<from zitadel oidc app>
OIDC_CLIENT_SECRET=<from zitadel oidc app>
OIDC_ISSUER=https://SSO.DOMAIN
COOKIE_SECRET=<token_urlsafe-32>
FORGEJO_DB_PASSWORD=<strong-db-password>
FORGEJO_DOMAIN=APP.DOMAIN
FORGEJO_VERSION=FORGEJO_VERSION
OAUTH2_PROXY_VERSION=OAUTH2_PROXY_VERSION
