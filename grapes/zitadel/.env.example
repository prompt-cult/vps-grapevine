# Zitadel domain (the FQDN Traefik routes to)
ZITADEL_DOMAIN=***SCRUBBED***

# HTTPS settings (Traefik does TLS, Zitadel sees plain HTTP internally)
ZITADEL_EXTERNALPORT=443
ZITADEL_EXTERNALSECURE=true

# Zitadel version
ZITADEL_VERSION=v4.17.3

# PostgreSQL
POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_DB=zitadel
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=<REDACTED: generate with openssl rand -base64 32>
ZITADEL_DATABASE_POSTGRES_DSN=postgresql://postgres:<REDACTED>@zitadel-postgres:5432/zitadel?sslmode=disable

# Zitadel masterkey (32-char hex string for AES-256)
ZITADEL_MASTERKEY=<REDACTED: generate with openssl rand -hex 16>

# Login client PAT expiration
LOGIN_CLIENT_PAT_EXPIRATION=2099-01-01T00:00:00Z

# Observability (disabled by default)
ZITADEL_ACCESS_LOG_STDOUT_ENABLED=true
ZITADEL_INSTRUMENTATION_TRACE_EXPORTER_TYPE=none
ZITADEL_INSTRUMENTATION_TRACE_EXPORTER_ENDPOINT=
ZITADEL_INSTRUMENTATION_TRACE_EXPORTER_INSECURE=true
ZITADEL_INSTRUMENTATION_SERVICENAME=zitadel-api

# Redis (disabled — no cache)
ZITADEL_CACHES_CONNECTORS_REDIS_ENABLED=false
