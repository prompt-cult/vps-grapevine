# Test container — whoami, for verifying Traefik routing

[Container]
Image=docker.io/traefik/whoami:latest
ContainerName=whoami
Network=traefik-net.network
Label=traefik.enable=true
Label=traefik.http.routers.whoami.rule=Host(`***SCRUBBED***`)
Label=traefik.http.routers.whoami.entrypoints=https
Label=traefik.http.routers.whoami.tls.certresolver=letsencrypt

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
